{
  "expo": {
    "name": "Majimap",
    "slug": "majimap",
    "version": "1.0.0",
    "scheme": "majimap",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.majimap.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.majimap.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      ["expo-location", { "locationWhenInUsePermission": "Majimap uses your location to show nearby assets and to record where new assets are." }],
      ["expo-image-picker", {
        "photosPermission": "Majimap attaches photos of assets you choose.",
        "cameraPermission": "Majimap takes photos of assets in the field.",
        "microphonePermission": false
      }]
    ]
  }
}